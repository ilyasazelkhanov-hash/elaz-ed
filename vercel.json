{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/courses",
      "destination": "/courses/index.html"
    },
    {
      "source": "/courses/directions/:code(VC|ENG|AU|AG|CR|DS|MK|DT|BI)",
      "destination": "/courses/directions/:code/index.html"
    },
    {
      "source": "/courses/:code(CORE-000|VC-101|VC-201|VC-301|ENG-101|ENG-201|ENG-301|AU-101|AU-201|AU-301|AG-101|AG-201|AG-301|CR-101|CR-201|CR-301|DS-101|DS-201|DS-301|MK-101|MK-201|MK-301|DT-101|DT-201|DT-301|BI-101|BI-201|BI-301)",
      "destination": "/courses/:code/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-src https://www.youtube.com https://rutube.ru https://vk.com; worker-src 'self' blob:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/academy",
      "destination": "/?demo=1#/academy",
      "permanent": false
    },
    {
      "source": "/academy/courses/:code",
      "destination": "/courses/:code",
      "permanent": false
    },
    {
      "source": "/academy/directions/:code",
      "destination": "/courses/directions/:code",
      "permanent": false
    }
  ]
}

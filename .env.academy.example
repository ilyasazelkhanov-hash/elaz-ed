# AI Academy is included in the main mini-app. VITE_ACADEMY_ENABLED is no longer needed.
# Until the aa_* server curriculum is published, only public course programs are available.
# Local ?demo uses the explicitly separate demo adapter.
# Academy currently ships in Russian. Preserve translations for a later release.
# Set true and rebuild to expose the RU / KK / EN language selector.
VITE_ACADEMY_MULTILINGUAL=false
# Keep the existing VITE_API_URL for the existing Telegram-authenticated OG API.
# The Academy endpoint is <VITE_API_URL>/academy, not a new public database client.
# Optional public origin for absolute canonical URLs in the 38 curriculum previews.
# ACADEMY_SITE_URL=https://your-domain.example
# Apply all three Academy migrations and deploy api before enabling production.
# Local Vite dev includes authored courses automatically.
# Production excludes authored bodies and quiz keys from demo assets by default.
# Only enable this for a deliberately public, separate demonstration deployment:
# VITE_ACADEMY_PUBLIC_DEMO=true

# Browser configuration. Never put a bot token or service key in VITE_*.
VITE_API_URL=/api
VITE_DEMO=true
# Set VITE_DEMO=false on production. demo is only enabled explicitly.

# Server secrets: configure through Supabase secrets, not frontend env.
# BOT_TOKEN=
# APP_URL=https://your-app.example
# ADMIN_TELEGRAM_IDS=123456789
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# CRON_SECRET=
# INTEGRATION_WEBHOOK_SECRET=
# WEBHOOK_SECRET=
# API_PUBLIC_PATH=/api
# ADMIN_RETURN_PATH=/admin
